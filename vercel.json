{
  "installCommand": "cd siga_frontend && npm install",
  "buildCommand": "cd siga_frontend && npm run build",
  "outputDirectory": "siga_frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://backend-production-861d98e0.up.railway.app/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://backend-production-861d98e0.up.railway.app/auth/$1"
    },
    {
      "source": "/core/(.*)",
      "destination": "https://backend-production-861d98e0.up.railway.app/core/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
