# Copiar a ".env.production" o configurar en Vercel (Environment Variables).
# IMPORTANTE: Vite inyecta estas variables EN TIEMPO DE BUILD.
# Si cambias después de un deploy, haz redeploy.

# URL pública del backend en Railway (sin barra final)
VITE_API_URL=https://TU-BACKEND.up.railway.app

# URL del WebSocket en Railway (sin /ws; el código agrega /ws solo)
VITE_WS_URL=wss://TU-BACKEND.up.railway.app
